@inherits LayoutComponentBase

@* Layout de las pantallas de acceso. No lleva menú lateral ni barra superior a
   propósito: en el login no hay nada que navegar, y el menú de la app en una pantalla
   sin sesión solo ofrece enlaces que no se pueden usar. *@

<div class="auth-shell">
    <aside class="auth-brand">
        @* Foco de luz que persigue al puntero. Decorativo: no lo lee el lector de pantalla. *@
        <span class="brand-foco" aria-hidden="true"></span>

        <div class="brand-top">
            <span class="brand-mark">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9l9-6 9 6v11a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" /></svg>
            </span>
            <span class="brand-id">
                <span class="brand-name">Mini ERP</span>
                <span class="brand-sub">Minimarket piloto</span>
            </span>
        </div>

        <div class="brand-body">
            <h2 class="brand-title">El mostrador, el inventario y la caja en una sola pantalla.</h2>
            <p class="brand-lead">
                Facturación con NCF, existencias al día y el número que el comerciante
                nunca ha visto: lo que de verdad ganó.
            </p>

            @* Las tres líneas son las características que explican el modelo de datos:
               peso y unidad, comprobante fiscal, contado y crédito. *@
            <ul class="brand-list">
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8" /></svg>
                    Inventario por peso y por unidad
                </li>
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h9l4 4v15a1 1 0 0 1-1.4.9L15 20l-2.5 1.9L10 20l-2.5 1.9L5 20l-.6.9A1 1 0 0 1 3 20V4a2 2 0 0 1 2-2z" /><path d="M8 8h7M8 12h7" /></svg>
                    Comprobantes fiscales con NCF
                </li>
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg>
                    Ventas al contado y a crédito
                </li>
            </ul>
        </div>

        <p class="brand-foot">Trabajo Final de Grado · Grupo 6 · Universidad Dominicana O&amp;M</p>
    </aside>

    <main class="auth-main">
        <div class="auth-panel">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@* Lo unico que hace falta en JavaScript: pasarle al CSS donde esta el puntero.
   El movimiento lo hace el CSS. *@
<script src="js/auth-foco.js"></script>
