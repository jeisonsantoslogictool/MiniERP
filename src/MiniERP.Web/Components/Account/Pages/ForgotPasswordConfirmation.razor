@page "/Account/ForgotPasswordConfirmation"
@layout AuthLayout

<PageTitle>Revisa tu correo · Mini ERP</PageTitle>

<header class="auth-head">
    <h1>Revisa tu correo</h1>
    <p>Si esa cuenta existe, ya va en camino.</p>
</header>

<div class="auth-note" role="alert">
    <p>
        Te enviamos un enlace para poner una contraseña nueva. Ábrelo desde el mismo
        dispositivo y ten a mano el correo de la cuenta.
    </p>
</div>

<p class="auth-foot">
    <a href="Account/Login">Volver a iniciar sesión</a>
</p>
