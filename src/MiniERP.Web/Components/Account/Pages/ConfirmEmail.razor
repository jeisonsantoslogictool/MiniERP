@page "/Account/ConfirmEmail"
@layout AuthLayout

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using MiniERP.Infrastructure.Persistence

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Confirmación de correo · Mini ERP</PageTitle>

<header class="auth-head">
    <h1>Confirmación de correo</h1>
    <p>Resultado del enlace que abriste.</p>
</header>

<StatusMessage Message="@statusMessage" />

<a class="w-100 btn btn-lg btn-primary" href="Account/Login">Iniciar sesión</a>

@code {
    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = "Error: no se encontró la cuenta de ese enlace.";
        }
        else
        {
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserManager.ConfirmEmailAsync(user, code);
            statusMessage = result.Succeeded
                ? "Correo confirmado. Ya puedes entrar."
                : "Error: no se pudo confirmar el correo. El enlace pudo vencer o ya haberse usado.";
        }
    }
}
