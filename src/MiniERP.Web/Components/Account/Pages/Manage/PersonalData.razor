@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using MiniERP.Infrastructure.Persistence

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Datos personales</PageTitle>

<StatusMessage />
<h2 class="h5 mb-3">Datos personales</h2>

<div class="row">
    <div class="col-xl-8">
        <p>
            Tu cuenta guarda los datos que registraste al crearla. Aquí puedes descargarlos
            o borrarlos.
        </p>

        <form action="Account/Manage/DownloadPersonalData" method="post" class="mb-3">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Descargar mis datos</button>
        </form>

        <div class="alert alert-danger" role="alert">
            <p class="mb-2">
                <strong>Borrar los datos elimina la cuenta para siempre y no se puede deshacer.</strong>
            </p>
            <p class="mb-0 small">
                Las facturas, compras y movimientos que registraste <strong>no se borran</strong>:
                son documentos del comercio y su historial tiene que quedar completo.
            </p>
        </div>

        <a href="Account/Manage/DeletePersonalData" class="btn btn-outline-danger">Borrar mi cuenta</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
