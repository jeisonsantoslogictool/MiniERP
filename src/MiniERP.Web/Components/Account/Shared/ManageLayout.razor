@inherits LayoutComponentBase
@layout MiniERP.Web.Components.Layout.MainLayout

@* Esta zona SI lleva el layout de la app: quien la usa ya tiene sesion abierta y viene
   del menu lateral. Lo que cambia es el encabezado, que antes eran dos titulos seguidos
   diciendo casi lo mismo. *@

<header class="mb-4">
    <h1 class="mb-1">Mi cuenta</h1>
    <p class="text-muted mb-0">Tus datos de acceso y la seguridad de tu usuario.</p>
</header>

@* El contenido se apoya en una tarjeta. Suelto sobre el lienzo, la pantalla no tenia
   donde empezar: un titulo, dos campos y un boton flotando en beige. *@
<div class="row g-4">
    <div class="col-lg-3">
        <ManageNavMenu />
    </div>
    <div class="col-lg-9">
        <div class="card">
            <div class="card-body p-4">
                @Body
            </div>
        </div>
    </div>
</div>
