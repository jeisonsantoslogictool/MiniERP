@page "/compras/nueva"
@page "/compras/{Id:int}"
@attribute [Authorize(Policy = "compras.recibir")]
@rendermode InteractiveServer
@inject ICompraService ServicioCompras
@inject IProveedorService ServicioProveedores
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth

<PageTitle>@(EsNueva ? "Nueva compra" : form.Numero)</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">@(EsNueva ? "Nueva compra" : form.Numero)</h1>
        @if (!EsNueva)
        {
            <span class="badge @Formato.ClaseEstadoCompra(form.Estado)">@Formato.EstadoCompra(form.Estado)</span>
        }
    </div>
    <a class="btn btn-outline-secondary" href="/compras">Volver</a>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (aviso is not null)
{
    <div class="alert alert-success" role="alert">@aviso</div>
}

@if (cargando)
{
    <p class="text-muted">Cargando...</p>
}
else if (noEncontrada)
{
    <div class="alert alert-warning">La compra no existe.</div>
}
else
{
    @if (form.Estado == EstadoCompra.Recibida)
    {
        <div class="alert alert-info">
            Esta compra ya se recibió el @Formato.FechaHora(form.Fecha) y el inventario se movió.
            El documento queda congelado: para revertirla hay que registrar una devolución al proveedor.
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-2">
            <label class="form-label">Número</label>
            <input class="form-control" @bind="form.Numero" disabled="@(!form.EsEditable)" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Proveedor</label>
            <select class="form-select" @bind="form.ProveedorId" disabled="@(!form.EsEditable)">
                <option value="0">Selecciona...</option>
                @foreach (var p in proveedores)
                {
                    <option value="@p.Id">@p.Texto</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">NCF del proveedor</label>
            <input class="form-control text-uppercase" @bind="form.NcfProveedor"
                   disabled="@(!form.EsEditable)" placeholder="B0100000001" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Condición</label>
            <select class="form-select" @bind="form.Condicion" disabled="@(!form.EsEditable)">
                <option value="@CondicionPago.Contado">Contado</option>
                <option value="@CondicionPago.Credito">Crédito</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-label">Observación</label>
            <input class="form-control" @bind="form.Observacion" disabled="@(!form.EsEditable)" />
        </div>
    </div>

    @if (form.EsEditable)
    {
        <div class="p-3 bg-body-secondary rounded mb-3">
            <label class="form-label">Agregar producto</label>
            <input class="form-control" placeholder="Escribe código, barras o descripción"
                   value="@busqueda" @oninput="OnBuscarProducto" />

            @if (sugerencias.Count > 0)
            {
                <div class="list-group mt-2">
                    @foreach (var p in sugerencias)
                    {
                        <button type="button" class="list-group-item list-group-item-action"
                                @onclick="() => AgregarLinea(p)">
                            <div class="d-flex justify-content-between">
                                <span><code>@p.Codigo</code> @p.Descripcion</span>
                                <span class="text-muted small">
                                    existencia @Formato.Cantidad(p.Existencia, p.PermiteDecimales) @p.UnidadMedida
                                    · costo @Formato.Dinero(p.Costo)
                                </span>
                            </div>
                        </button>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(busqueda))
            {
                <div class="form-text">Ningún producto coincide.</div>
            }
        </div>
    }

    @if (form.Lineas.Count == 0)
    {
        <div class="alert alert-secondary">Esta compra no tiene líneas todavía.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Descripción</th>
                        <th style="width: 130px">Cantidad</th>
                        <th style="width: 130px">Costo</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">ITBIS</th>
                        <th class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linea in form.Lineas)
                    {
                        <tr>
                            <td><code>@linea.Codigo</code></td>
                            <td>@linea.Descripcion</td>
                            <td>
                                @if (form.EsEditable)
                                {
                                    <div class="input-group input-group-sm">
                                        <input class="form-control" type="number"
                                               step="@(linea.PermiteDecimales ? "0.001" : "1")"
                                               value="@linea.Cantidad"
                                               @onchange="e => CambiarCantidad(linea, e)" />
                                        <span class="input-group-text">@linea.UnidadMedida</span>
                                    </div>
                                }
                                else
                                {
                                    <span>@Formato.Cantidad(linea.Cantidad, linea.PermiteDecimales) @linea.UnidadMedida</span>
                                }
                            </td>
                            <td>
                                @if (form.EsEditable)
                                {
                                    <input class="form-control form-control-sm" type="number" step="0.0001"
                                           value="@linea.CostoUnitario"
                                           @onchange="e => CambiarCosto(linea, e)" />
                                }
                                else
                                {
                                    <span>@Formato.Dinero(linea.CostoUnitario)</span>
                                }
                            </td>
                            <td class="text-end">@Formato.Dinero(linea.Subtotal)</td>
                            <td class="text-end text-muted">
                                @Formato.Dinero(linea.Itbis)
                                @if (linea.TasaItbis == 0)
                                {
                                    <br />
                                    <span class="badge text-bg-light">Exento</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">@Formato.Dinero(linea.Total)</td>
                            <td class="text-end">
                                @if (form.EsEditable)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => QuitarLinea(linea)">Quitar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4"></td>
                        <td class="text-end">@Formato.Dinero(form.Subtotal)</td>
                        <td class="text-end">@Formato.Dinero(form.Itbis)</td>
                        <td class="text-end fs-5 fw-bold">@Formato.Dinero(form.Total)</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    <div class="mt-4 d-flex gap-2">
        @if (form.EsEditable)
        {
            <AuthorizeView Policy="compras.recibir">
                <button class="btn btn-primary" @onclick="Guardar" disabled="@ocupado">
                    @(ocupado ? "Guardando..." : "Guardar borrador")
                </button>
            </AuthorizeView>

            @if (!EsNueva)
            {
                <AuthorizeView Policy="compras.recibir">
                    <button class="btn btn-success" @onclick="Recibir" disabled="@ocupado">
                        Recibir mercancía
                    </button>
                    <button class="btn btn-outline-danger ms-auto" @onclick="Anular" disabled="@ocupado">
                        Anular
                    </button>
                </AuthorizeView>
            }
        }
    </div>

    @if (form.EsEditable && !EsNueva)
    {
        <p class="form-text mt-2">
            Recibir la mercancía suma al inventario, recalcula el costo promedio de cada producto
            y congela el documento. No se puede deshacer.
        </p>
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private CompraFormDto form = new();
    private IReadOnlyList<OpcionDto> proveedores = [];
    private IReadOnlyList<ProductoParaCompraDto> sugerencias = [];

    private string? busqueda;
    private string? error;
    private string? aviso;
    private bool cargando = true;
    private bool ocupado;
    private bool noEncontrada;
    private string? usuarioId;

    private bool EsNueva => Id is null;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;

        var estado = await Auth.GetAuthenticationStateAsync();
        usuarioId = estado.User.Identity?.Name;

        proveedores = await ServicioProveedores.ObtenerOpcionesAsync();

        if (Id is { } id)
        {
            var existente = await ServicioCompras.ObtenerParaEditarAsync(id);

            if (existente is null)
            {
                noEncontrada = true;
                cargando = false;
                return;
            }

            form = existente;
        }
        else
        {
            form = await ServicioCompras.NuevaAsync();
        }

        cargando = false;
    }

    private async Task OnBuscarProducto(ChangeEventArgs e)
    {
        busqueda = e.Value?.ToString();

        sugerencias = string.IsNullOrWhiteSpace(busqueda)
            ? []
            : await ServicioCompras.BuscarProductosAsync(busqueda);
    }

    private void AgregarLinea(ProductoParaCompraDto p)
    {
        if (form.Lineas.Any(l => l.ProductoId == p.Id))
        {
            error = $"'{p.Descripcion}' ya está en la compra. Cambia su cantidad en la línea.";
            return;
        }

        // El costo se propone con el que trae el producto: casi siempre el proveedor
        // mantiene el precio, y así el usuario solo lo corrige cuando cambió.
        form.Lineas.Add(new LineaCompraFormDto
        {
            ProductoId = p.Id,
            Codigo = p.Codigo,
            Descripcion = p.Descripcion,
            UnidadMedida = p.UnidadMedida,
            PermiteDecimales = p.PermiteDecimales,
            Cantidad = 1,
            CostoUnitario = p.Costo,
            TasaItbis = p.TasaItbis
        });

        busqueda = null;
        sugerencias = [];
        error = null;
    }

    private void QuitarLinea(LineaCompraFormDto linea) => form.Lineas.Remove(linea);

    private static void CambiarCantidad(LineaCompraFormDto linea, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var valor))
            linea.Cantidad = valor;
    }

    private static void CambiarCosto(LineaCompraFormDto linea, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var valor))
            linea.CostoUnitario = valor;
    }

    private async Task Guardar()
    {
        error = aviso = null;
        ocupado = true;

        try
        {
            var resultado = await ServicioCompras.GuardarAsync(form, usuarioId);

            if (resultado.Fallo)
            {
                error = resultado.Error;
                return;
            }

            if (EsNueva)
            {
                Nav.NavigateTo($"/compras/{resultado.Valor}");
                return;
            }

            aviso = "Borrador guardado.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task Recibir()
    {
        error = aviso = null;
        ocupado = true;

        try
        {
            // Se guarda primero: recibir trabaja sobre lo que hay en la base, no sobre
            // lo que el usuario tenga en pantalla sin guardar.
            var guardado = await ServicioCompras.GuardarAsync(form, usuarioId);

            if (guardado.Fallo)
            {
                error = guardado.Error;
                return;
            }

            var resultado = await ServicioCompras.RecibirAsync(form.Id, usuarioId);

            if (resultado.Fallo)
            {
                error = resultado.Error;
                return;
            }

            form = (await ServicioCompras.ObtenerParaEditarAsync(form.Id))!;
            aviso = "Mercancía recibida. El inventario se actualizó y los costos se recalcularon.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task Anular()
    {
        error = aviso = null;
        ocupado = true;

        try
        {
            var resultado = await ServicioCompras.AnularAsync(form.Id, usuarioId);

            if (resultado.Fallo)
            {
                error = resultado.Error;
                return;
            }

            form = (await ServicioCompras.ObtenerParaEditarAsync(form.Id))!;
            aviso = "Compra anulada.";
        }
        finally
        {
            ocupado = false;
        }
    }
}
