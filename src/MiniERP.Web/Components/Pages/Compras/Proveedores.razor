@page "/compras/proveedores"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IProveedorService ServicioProveedores

<PageTitle>Proveedores</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Proveedores</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/compras">Volver a compras</a>
        <a class="btn btn-primary" href="/compras/proveedores/nuevo">Nuevo proveedor</a>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input class="form-control" placeholder="Buscar por código, nombre, RNC o contacto"
               value="@texto" @oninput="OnTextoChanged" />
    </div>
</div>

@if (pagina is null)
{
    <p class="text-muted">Cargando...</p>
}
else if (pagina.Total == 0)
{
    <div class="alert alert-secondary">Todavía no hay proveedores registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Documento</th>
                    <th>Contacto</th>
                    <th class="text-end">Días crédito</th>
                    <th class="text-end">Le debemos</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in pagina.Items)
                {
                    <tr class="@(p.Activo ? "" : "opacity-50")">
                        <td><code>@p.Codigo</code></td>
                        <td>
                            @p.Nombre
                            @if (!p.Activo)
                            {
                                <span class="badge text-bg-secondary ms-1">Inactivo</span>
                            }
                        </td>
                        <td class="small">
                            @if (p.TipoDocumento == TipoDocumento.Ninguno)
                            {
                                <span class="text-muted">Sin documento</span>
                            }
                            else
                            {
                                <span class="text-muted">@Formato.Documento(p.TipoDocumento)</span>
                                <br />
                                <span>@p.NumeroDocumento</span>
                            }
                        </td>
                        <td class="small">
                            @p.Contacto
                            @if (!string.IsNullOrEmpty(p.Telefono))
                            {
                                <br />
                                <span class="text-muted">@p.Telefono</span>
                            }
                        </td>
                        <td class="text-end">@(p.DiasCredito == 0 ? "Contado" : $"{p.DiasCredito} días")</td>
                        <td class="text-end @(p.BalanceActual > 0 ? "fw-semibold" : "text-muted")">
                            @Formato.Dinero(p.BalanceActual)
                        </td>
                        <td class="text-end text-nowrap">
                            @if (p.BalanceActual > 0)
                            {
                                <a class="btn btn-sm btn-success me-1" href="/proveedores/@p.Id/pago">Pagar</a>
                            }
                            <a class="btn btn-sm btn-outline-secondary" href="/compras/proveedores/@p.Id">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <small class="text-muted">@pagina.Total proveedor(es)</small>
}

@code {
    private PaginaDe<ProveedorListaDto>? pagina;
    private string? texto;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar() =>
        pagina = await ServicioProveedores.BuscarAsync(new FiltroProveedores(Texto: texto, SoloActivos: false));

    private async Task OnTextoChanged(ChangeEventArgs e)
    {
        texto = e.Value?.ToString();
        await Cargar();
    }
}
