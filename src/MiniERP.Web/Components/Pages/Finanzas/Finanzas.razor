@page "/finanzas"
@attribute [Authorize]

<PageTitle>Finanzas</PageTitle>

<h1 class="mb-3">Finanzas</h1>

<p class="lead">Ingresos, egresos, costos y reportes de rentabilidad.</p>

<div class="row g-3">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Egresos</h2>
                <p class="text-muted small flex-grow-1">
                    Registra los gastos operativos: alquiler, luz, agua, sueldos, transporte.
                    No incluye compras de mercancía ni pagos a proveedor.
                </p>
                <a class="btn btn-primary" href="/finanzas/egresos">Ir a egresos</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Ingresos</h2>
                <p class="text-muted small flex-grow-1">
                    Las ventas de un período, separando contado de crédito, con su ITBIS
                    aparte y sin las facturas anuladas.
                </p>
                <a class="btn btn-primary" href="/finanzas/ingresos">Ver ingresos</a>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-secondary mt-4" role="alert">
    Los reportes de <strong>ingresos</strong>, <strong>rentabilidad</strong>,
    <strong>estado de resultados</strong>, <strong>flujo de caja</strong> y el
    <strong>panel</strong> llegan en las siguientes tareas de F3.
</div>
