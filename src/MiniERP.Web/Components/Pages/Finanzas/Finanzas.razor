@page "/finanzas"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IPanelFinanzasService ServicioPanel

<PageTitle>Finanzas</PageTitle>

<h1 class="mb-3">Finanzas</h1>

@if (panel is null)
{
    <p class="text-muted">Cargando panel...</p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg">
            <div class="p-3 rounded bg-body-secondary h-100">
                <small class="text-muted d-block">Ventas del día</small>
                <strong class="fs-5">@Formato.Dinero(panel.VentasDia)</strong>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg">
            <div class="p-3 rounded bg-success-subtle h-100">
                <small class="text-muted d-block">Margen del día</small>
                <strong class="fs-5">@Formato.Dinero(panel.MargenDia)</strong>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg">
            <div class="p-3 rounded bg-body-secondary h-100">
                <small class="text-muted d-block">Egresos del mes</small>
                <strong class="fs-5">@Formato.Dinero(panel.EgresosMes)</strong>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg">
            <div class="p-3 rounded @(panel.UtilidadMes < 0 ? "bg-danger-subtle" : "bg-success-subtle") h-100">
                <small class="text-muted d-block">Utilidad del mes</small>
                <strong class="fs-5">@Formato.Dinero(panel.UtilidadMes)</strong>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg">
            <div class="p-3 rounded bg-body-secondary h-100">
                <small class="text-muted d-block">Efectivo del mes</small>
                <strong class="fs-5">@Formato.Dinero(panel.EfectivoMes)</strong>
            </div>
        </div>
    </div>
}

<h2 class="h5 mb-3">Registros y reportes</h2>

<div class="row g-3">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h3 class="h6">Egresos</h3>
                <p class="text-muted small flex-grow-1">
                    Gastos operativos: alquiler, luz, agua, sueldos, transporte.
                </p>
                <a class="btn btn-outline-primary btn-sm" href="/finanzas/egresos">Ir a egresos</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h3 class="h6">Ingresos</h3>
                <p class="text-muted small flex-grow-1">
                    Ventas del período, contado vs. crédito, con su ITBIS aparte.
                </p>
                <a class="btn btn-outline-primary btn-sm" href="/finanzas/ingresos">Ver ingresos</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h3 class="h6">Rentabilidad</h3>
                <p class="text-muted small flex-grow-1">
                    El margen del período, por producto y por categoría.
                </p>
                <a class="btn btn-outline-primary btn-sm" href="/finanzas/rentabilidad">Ver rentabilidad</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h3 class="h6">Estado de resultados</h3>
                <p class="text-muted small flex-grow-1">
                    Ingresos − costo de lo vendido − egresos = utilidad.
                </p>
                <a class="btn btn-outline-primary btn-sm" href="/finanzas/estado-resultados">Ver estado</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h3 class="h6">Flujo de caja</h3>
                <p class="text-muted small flex-grow-1">
                    Cuánto efectivo entra y sale: distinto de la utilidad.
                </p>
                <a class="btn btn-outline-primary btn-sm" href="/finanzas/flujo-caja">Ver flujo</a>
            </div>
        </div>
    </div>
</div>

@code {
    private PanelFinanzasDto? panel;

    protected override async Task OnInitializedAsync() =>
        panel = await ServicioPanel.ObtenerAsync();
}
