@page "/ventas/facturas/{Id:int}"
@attribute [Authorize(Policy = Permisos.VentasVer)]
@rendermode InteractiveServer
@inject IVentaService ServicioVentas
@inject DatosEmisor Comercio
@inject IJSRuntime JS
@inject AuthenticationStateProvider Auth
@inject IAuthorizationService Autorizacion

<PageTitle>@(factura?.Numero ?? "Factura")</PageTitle>

@* El tamano del papel no se puede fijar desde la hoja de estilos compartida: `@@page`
   vale para el documento entero y esta aplicacion tambien imprime reportes en carta.
   Declarado aqui, el rollo de 88 mm existe solo mientras esta pagina esta abierta. *@
<HeadContent>
    <style>
        @@page { size: 88mm auto; margin: 0; }
    </style>
</HeadContent>

<div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
    <div>
        <h1 class="mb-0">@(factura?.Numero ?? "Factura")</h1>
        @if (factura is not null)
        {
            <span class="badge @Formato.ClaseEstadoFactura(factura.Estado)">@Formato.EstadoFactura(factura.Estado)</span>
        }
    </div>
    <div class="d-flex gap-2">
        @* Ver la factura (ventas.ver) no es lo mismo que poder anularla (ventas.anular):
           un cajero o un supervisor consultan, pero deshacer una venta emitida es del
           administrador o de quien tenga ese permiso concedido en su matriz. *@
        @if (factura is not null && factura.Estado == EstadoFactura.Emitida)
        {
            <AuthorizeView Policy="@Permisos.VentasAnular" Context="permisoAnular">
                <button class="btn btn-outline-danger" @onclick="MostrarAnular">Anular</button>
            </AuthorizeView>
        }
        @if (factura is not null)
        {
            <button class="btn btn-outline-primary" @onclick="Imprimir">Imprimir</button>
        }
        @if (factura is not null && factura.Estado == EstadoFactura.Emitida)
        {
            @* Una factura anulada no genera e-CF: ante la DGII eso se retira con una
               anulación de e-NCF, no volviendo a emitir el comprobante. *@
            <a class="btn btn-outline-primary" href="/ventas/facturas/@Id/ecf">e-CF</a>
        }
        <a class="btn btn-outline-secondary" href="/ventas/facturas">Volver</a>
    </div>
</div>

@if (cargando)
{
    <p class="text-muted">Cargando...</p>
}
else if (factura is null)
{
    <div class="alert alert-warning">La factura no existe.</div>
}
else
{
    @if (error is not null)
    {
        <div class="alert alert-danger d-print-none">@error</div>
    }
    @if (aviso is not null)
    {
        <div class="alert alert-success d-print-none">@aviso</div>
    }

    @if (mostrandoAnular)
    {
        <AuthorizeView Policy="@Permisos.VentasAnular" Context="permisoAnular">
            <div class="card border-danger mb-4 d-print-none">
                <div class="card-body">
                    <h2 class="h6 text-danger mb-2">Anular esta factura</h2>
                    <p class="small text-muted mb-2">
                        Se repone el inventario y, si fue a crédito, baja la deuda del cliente. El NCF queda
                        como comprobante anulado ante la DGII. <strong>No se puede deshacer.</strong>
                    </p>
                    <textarea class="form-control mb-2" rows="2" placeholder="Motivo de la anulación"
                              @bind="motivo" @bind:event="oninput"></textarea>
                    <div class="d-flex gap-2">
                        <button class="btn btn-danger" @onclick="ConfirmarAnular" disabled="@anulando">
                            @(anulando ? "Anulando..." : "Confirmar anulación")
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="CancelarAnular" disabled="@anulando">Cancelar</button>
                    </div>
                </div>
            </div>
        </AuthorizeView>
    }

    @* En papel la factura no es una hoja: es un rollo termico de 88 mm. Lo que se ve en
       pantalla —dos tarjetas y una tabla de seis columnas— no entra en ese ancho, asi que
       el ticket se arma aparte y solo existe al imprimir. El orden es el que el cliente
       lee: quien vende, que comprobante es, que se llevo y cuanto pago. *@
    <div class="ticket d-none d-print-block">

        @* El emisor sale de la seccion "Comercio" de configuracion, la misma que firma el
           e-CF: un solo sitio para los datos fiscales del que vende. *@
        <div class="tk-comercio">@NombreDelComercio</div>
        @if (MuestraRazonSocial)
        {
            <div class="tk-centro">@Comercio.RazonSocial</div>
        }
        @if (!string.IsNullOrWhiteSpace(Comercio.Rnc))
        {
            <div class="tk-centro">RNC: @Comercio.Rnc</div>
        }
        @if (!string.IsNullOrWhiteSpace(Comercio.Direccion))
        {
            <div class="tk-centro">@Comercio.Direccion</div>
        }
        @if (!string.IsNullOrWhiteSpace(Comercio.Telefono))
        {
            <div class="tk-centro">Tel: @Comercio.Telefono</div>
        }

        <div class="tk-sep"></div>

        @* El NCF es lo que la DGII busca de un vistazo: va solo, grande y espaciado. *@
        <div class="tk-centro">@Formato.Comprobante(factura.TipoComprobante)</div>
        <div class="tk-ncf">@(factura.Ncf ?? "—")</div>
        <div class="tk-centro">No. @factura.Numero</div>
        <div class="tk-centro">@Formato.FechaHora(factura.Fecha)</div>

        @if (factura.Estado == EstadoFactura.Anulada)
        {
            @* Un ticket anulado que no lo diga circula como si valiera. *@
            <div class="tk-anulada">*** ANULADA ***</div>
            @if (!string.IsNullOrWhiteSpace(factura.MotivoAnulacion))
            {
                <div class="tk-centro">@factura.MotivoAnulacion</div>
            }
        }

        <div class="tk-sep"></div>

        <div>Cliente: <strong>@factura.ClienteNombre</strong></div>
        @if (!string.IsNullOrWhiteSpace(factura.ClienteDocumento))
        {
            <div>RNC/Ced.: <strong>@factura.ClienteDocumento</strong></div>
        }
        <div>Pago: <strong>@(factura.Condicion == CondicionPago.Contado ? "Contado" : "Crédito")</strong></div>
        @if (!string.IsNullOrWhiteSpace(factura.UsuarioId))
        {
            <div class="tk-nota-izq">Cajero: @factura.UsuarioId</div>
        }

        <div class="tk-sep"></div>

        @* La descripcion se lleva su propia linea: a 88 mm no cabe al lado de la cantidad
           y el importe sin partirse por la mitad. Debajo va el renglon del calculo. *@
        @foreach (var l in factura.Lineas)
        {
            <div class="tk-linea">
                <div class="tk-desc">@l.Descripcion</div>
                <div class="tk-fila">
                    <span>@Formato.Cantidad(l.Cantidad, l.PermiteDecimales) @l.UnidadMedida x @Formato.Dinero(l.PrecioUnitario)</span>
                    <span>@Formato.Dinero(l.Total)</span>
                </div>
                @if (l.TasaItbis == 0)
                {
                    <div class="tk-nota">Exento de ITBIS</div>
                }
                else
                {
                    <div class="tk-nota">ITBIS: @Formato.Dinero(l.Itbis)</div>
                }
            </div>
        }

        <div class="tk-sep"></div>

        <div class="tk-fila"><span>Subtotal</span><span>@Formato.Dinero(factura.Subtotal)</span></div>
        <div class="tk-fila"><span>ITBIS</span><span>@Formato.Dinero(factura.Itbis)</span></div>
        <div class="tk-fila tk-total"><span>TOTAL</span><span>@Formato.Dinero(factura.Total)</span></div>
        @if (factura.Condicion == CondicionPago.Contado)
        {
            <div class="tk-fila"><span>Recibido</span><span>@Formato.Dinero(factura.MontoRecibido)</span></div>
            <div class="tk-fila"><span>Cambio</span><span>@Formato.Dinero(factura.Cambio)</span></div>
        }

        <div class="tk-sep"></div>

        <div class="tk-centro tk-gracias">Gracias por su compra</div>
    </div>

    @if (factura.Estado == EstadoFactura.Anulada)
    {
        <div class="alert alert-danger d-print-none">
            <strong>Factura anulada.</strong>
            @if (!string.IsNullOrWhiteSpace(factura.MotivoAnulacion))
            {
                <span> Motivo: @factura.MotivoAnulacion</span>
            }
        </div>
    }

    <div class="row g-3 mb-4 d-print-none">
        <div class="col-md-6">
            <div class="border rounded p-3 h-100">
                <h2 class="h6 text-muted">Comprobante</h2>
                <dl class="row mb-0">
                    <dt class="col-5 fw-normal text-muted">NCF</dt>
                    <dd class="col-7"><code>@(factura.Ncf ?? "—")</code></dd>
                    <dt class="col-5 fw-normal text-muted">Tipo</dt>
                    <dd class="col-7">@Formato.Comprobante(factura.TipoComprobante)</dd>
                    <dt class="col-5 fw-normal text-muted">Fecha</dt>
                    <dd class="col-7">@Formato.FechaHora(factura.Fecha)</dd>
                    <dt class="col-5 fw-normal text-muted">Condición</dt>
                    <dd class="col-7">@(factura.Condicion == CondicionPago.Contado ? "Contado" : "Crédito")</dd>
                    @if (!string.IsNullOrWhiteSpace(factura.UsuarioId))
                    {
                        <dt class="col-5 fw-normal text-muted">Cajero</dt>
                        <dd class="col-7">@factura.UsuarioId</dd>
                    }
                </dl>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded p-3 h-100">
                <h2 class="h6 text-muted">Cliente</h2>
                <dl class="row mb-0">
                    <dt class="col-5 fw-normal text-muted">Nombre</dt>
                    <dd class="col-7">@factura.ClienteNombre</dd>
                    <dt class="col-5 fw-normal text-muted">Documento</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(factura.ClienteDocumento) ? "—" : factura.ClienteDocumento)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="table-responsive d-print-none">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">ITBIS</th>
                    <th class="text-end">Importe</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in factura.Lineas)
                {
                    <tr>
                        <td><code>@l.Codigo</code></td>
                        <td>@l.Descripcion</td>
                        <td class="text-end text-nowrap">@Formato.Cantidad(l.Cantidad, l.PermiteDecimales) @l.UnidadMedida</td>
                        <td class="text-end">@Formato.Dinero(l.PrecioUnitario)</td>
                        <td class="text-end text-muted">
                            @if (l.TasaItbis == 0)
                            {
                                <span class="badge text-bg-light">Exento</span>
                            }
                            else
                            {
                                @Formato.Dinero(l.Itbis)
                            }
                        </td>
                        <td class="text-end fw-semibold">@Formato.Dinero(l.Total)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row justify-content-end d-print-none">
        <div class="col-md-5 col-lg-4">
            <dl class="row mb-0 border-top pt-3">
                <dt class="col-6 fw-normal text-muted">Subtotal</dt>
                <dd class="col-6 text-end">@Formato.Dinero(factura.Subtotal)</dd>
                <dt class="col-6 fw-normal text-muted">ITBIS</dt>
                <dd class="col-6 text-end">@Formato.Dinero(factura.Itbis)</dd>
                <dt class="col-6 fw-bold fs-5">Total</dt>
                <dd class="col-6 text-end fw-bold fs-5">@Formato.Dinero(factura.Total)</dd>
                @if (factura.Condicion == CondicionPago.Contado)
                {
                    <dt class="col-6 fw-normal text-muted">Recibido</dt>
                    <dd class="col-6 text-end">@Formato.Dinero(factura.MontoRecibido)</dd>
                    <dt class="col-6 fw-normal text-muted">Cambio</dt>
                    <dd class="col-6 text-end">@Formato.Dinero(factura.Cambio)</dd>
                }
            </dl>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private FacturaDetalleDto? factura;
    private bool cargando = true;
    private string? usuarioId;

    private bool mostrandoAnular;
    private string? motivo;
    private bool anulando;
    private string? error;
    private string? aviso;

    /// <summary>
    /// El rotulo del ticket: el nombre con que se conoce el negocio, y la razon social
    /// debajo solo si no es la misma. En un rollo cada linea cuesta papel.
    /// </summary>
    private string NombreDelComercio =>
        string.IsNullOrWhiteSpace(Comercio.NombreComercial)
            ? Comercio.RazonSocial
            : Comercio.NombreComercial;

    private bool MuestraRazonSocial =>
        !string.IsNullOrWhiteSpace(Comercio.RazonSocial)
        && !string.Equals(Comercio.RazonSocial, NombreDelComercio, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;

        var estado = await Auth.GetAuthenticationStateAsync();
        usuarioId = estado.User.Identity?.Name;

        factura = await ServicioVentas.ObtenerDetalleAsync(Id);
        cargando = false;
    }

    /// <summary>
    /// Segunda barrera, del lado del servidor. El AuthorizeView solo decide que se dibuja;
    /// los manejadores de un circuito de Blazor Server corren en el servidor y son el
    /// unico punto por el que la anulacion llega al servicio, asi que aqui se vuelve a
    /// preguntar. Si a un usuario le quitan el permiso con la pagina abierta, el circuito
    /// aun tiene el principal viejo hasta la proxima revalidacion: este chequeo lo cubre.
    /// </summary>
    private async Task<bool> PuedeAnularAsync()
    {
        var estado = await Auth.GetAuthenticationStateAsync();
        var decision = await Autorizacion.AuthorizeAsync(estado.User, Permisos.VentasAnular);

        return decision.Succeeded;
    }

    private async Task MostrarAnular()
    {
        error = aviso = null;

        if (!await PuedeAnularAsync())
        {
            error = "No tienes permiso para anular facturas.";
            return;
        }

        mostrandoAnular = true;
    }

    private void CancelarAnular()
    {
        mostrandoAnular = false;
        motivo = null;
        error = null;
    }

    private async Task ConfirmarAnular()
    {
        error = null;

        if (!await PuedeAnularAsync())
        {
            error = "No tienes permiso para anular facturas.";
            mostrandoAnular = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(motivo))
        {
            error = "Escribe el motivo de la anulación.";
            return;
        }

        anulando = true;

        try
        {
            var resultado = await ServicioVentas.AnularAsync(Id, motivo!, usuarioId);

            if (resultado.Fallo)
            {
                error = resultado.Error;
                return;
            }

            // La factura se recarga: ahora aparece anulada, con su motivo.
            factura = await ServicioVentas.ObtenerDetalleAsync(Id);
            mostrandoAnular = false;
            motivo = null;
            aviso = "Factura anulada. El inventario se repuso" +
                (factura?.Condicion == CondicionPago.Credito ? " y se descargó la deuda del cliente." : ".");
        }
        finally
        {
            anulando = false;
        }
    }

    private async Task Imprimir() => await JS.InvokeVoidAsync("print");
}
