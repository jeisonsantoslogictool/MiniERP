@page "/ventas/facturas/{Id:int}"
@attribute [Authorize(Policy = Permisos.VentasVer)]
@rendermode InteractiveServer
@inject IVentaService ServicioVentas
@inject IJSRuntime JS
@inject AuthenticationStateProvider Auth

<PageTitle>@(factura?.Numero ?? "Factura")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
    <div>
        <h1 class="mb-0">@(factura?.Numero ?? "Factura")</h1>
        @if (factura is not null)
        {
            <span class="badge @Formato.ClaseEstadoFactura(factura.Estado)">@Formato.EstadoFactura(factura.Estado)</span>
        }
    </div>
    <div class="d-flex gap-2">
        @if (factura is not null && factura.Estado == EstadoFactura.Emitida)
        {
            <button class="btn btn-outline-danger" @onclick="MostrarAnular">Anular</button>
        }
        @if (factura is not null)
        {
            <button class="btn btn-outline-primary" @onclick="Imprimir">Imprimir</button>
        }
        @if (factura is not null && factura.Estado == EstadoFactura.Emitida)
        {
            @* Una factura anulada no genera e-CF: ante la DGII eso se retira con una
               anulación de e-NCF, no volviendo a emitir el comprobante. *@
            <a class="btn btn-outline-primary" href="/ventas/facturas/@Id/ecf">e-CF</a>
        }
        <a class="btn btn-outline-secondary" href="/ventas/facturas">Volver</a>
    </div>
</div>

@if (cargando)
{
    <p class="text-muted">Cargando...</p>
}
else if (factura is null)
{
    <div class="alert alert-warning">La factura no existe.</div>
}
else
{
    @if (error is not null)
    {
        <div class="alert alert-danger d-print-none">@error</div>
    }
    @if (aviso is not null)
    {
        <div class="alert alert-success d-print-none">@aviso</div>
    }

    @if (mostrandoAnular)
    {
        <div class="card border-danger mb-4 d-print-none">
            <div class="card-body">
                <h2 class="h6 text-danger mb-2">Anular esta factura</h2>
                <p class="small text-muted mb-2">
                    Se repone el inventario y, si fue a crédito, baja la deuda del cliente. El NCF queda
                    como comprobante anulado ante la DGII. <strong>No se puede deshacer.</strong>
                </p>
                <textarea class="form-control mb-2" rows="2" placeholder="Motivo de la anulación"
                          @bind="motivo" @bind:event="oninput"></textarea>
                <div class="d-flex gap-2">
                    <button class="btn btn-danger" @onclick="ConfirmarAnular" disabled="@anulando">
                        @(anulando ? "Anulando..." : "Confirmar anulación")
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="CancelarAnular" disabled="@anulando">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @* Encabezado que solo aparece en el papel: da forma de documento fiscal. *@
    <div class="d-none d-print-block text-center mb-4">
        <h2 class="mb-1">FACTURA</h2>
        <div>@Formato.Comprobante(factura.TipoComprobante)</div>
        <div>NCF: <strong>@(factura.Ncf ?? "—")</strong> · No. @factura.Numero</div>
        <div class="small">@Formato.FechaHora(factura.Fecha)</div>
        @if (factura.Estado == EstadoFactura.Anulada)
        {
            <div class="fw-bold mt-1">
                *** ANULADA ***@(string.IsNullOrWhiteSpace(factura.MotivoAnulacion) ? "" : $" — {factura.MotivoAnulacion}")
            </div>
        }
    </div>

    @if (factura.Estado == EstadoFactura.Anulada)
    {
        <div class="alert alert-danger d-print-none">
            <strong>Factura anulada.</strong>
            @if (!string.IsNullOrWhiteSpace(factura.MotivoAnulacion))
            {
                <span> Motivo: @factura.MotivoAnulacion</span>
            }
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="border rounded p-3 h-100">
                <h2 class="h6 text-muted">Comprobante</h2>
                <dl class="row mb-0">
                    <dt class="col-5 fw-normal text-muted">NCF</dt>
                    <dd class="col-7"><code>@(factura.Ncf ?? "—")</code></dd>
                    <dt class="col-5 fw-normal text-muted">Tipo</dt>
                    <dd class="col-7">@Formato.Comprobante(factura.TipoComprobante)</dd>
                    <dt class="col-5 fw-normal text-muted">Fecha</dt>
                    <dd class="col-7">@Formato.FechaHora(factura.Fecha)</dd>
                    <dt class="col-5 fw-normal text-muted">Condición</dt>
                    <dd class="col-7">@(factura.Condicion == CondicionPago.Contado ? "Contado" : "Crédito")</dd>
                    @if (!string.IsNullOrWhiteSpace(factura.UsuarioId))
                    {
                        <dt class="col-5 fw-normal text-muted">Cajero</dt>
                        <dd class="col-7">@factura.UsuarioId</dd>
                    }
                </dl>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded p-3 h-100">
                <h2 class="h6 text-muted">Cliente</h2>
                <dl class="row mb-0">
                    <dt class="col-5 fw-normal text-muted">Nombre</dt>
                    <dd class="col-7">@factura.ClienteNombre</dd>
                    <dt class="col-5 fw-normal text-muted">Documento</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(factura.ClienteDocumento) ? "—" : factura.ClienteDocumento)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">ITBIS</th>
                    <th class="text-end">Importe</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in factura.Lineas)
                {
                    <tr>
                        <td><code>@l.Codigo</code></td>
                        <td>@l.Descripcion</td>
                        <td class="text-end text-nowrap">@Formato.Cantidad(l.Cantidad, l.PermiteDecimales) @l.UnidadMedida</td>
                        <td class="text-end">@Formato.Dinero(l.PrecioUnitario)</td>
                        <td class="text-end text-muted">
                            @if (l.TasaItbis == 0)
                            {
                                <span class="badge text-bg-light">Exento</span>
                            }
                            else
                            {
                                @Formato.Dinero(l.Itbis)
                            }
                        </td>
                        <td class="text-end fw-semibold">@Formato.Dinero(l.Total)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row justify-content-end">
        <div class="col-md-5 col-lg-4">
            <dl class="row mb-0 border-top pt-3">
                <dt class="col-6 fw-normal text-muted">Subtotal</dt>
                <dd class="col-6 text-end">@Formato.Dinero(factura.Subtotal)</dd>
                <dt class="col-6 fw-normal text-muted">ITBIS</dt>
                <dd class="col-6 text-end">@Formato.Dinero(factura.Itbis)</dd>
                <dt class="col-6 fw-bold fs-5">Total</dt>
                <dd class="col-6 text-end fw-bold fs-5">@Formato.Dinero(factura.Total)</dd>
                @if (factura.Condicion == CondicionPago.Contado)
                {
                    <dt class="col-6 fw-normal text-muted">Recibido</dt>
                    <dd class="col-6 text-end">@Formato.Dinero(factura.MontoRecibido)</dd>
                    <dt class="col-6 fw-normal text-muted">Cambio</dt>
                    <dd class="col-6 text-end">@Formato.Dinero(factura.Cambio)</dd>
                }
            </dl>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private FacturaDetalleDto? factura;
    private bool cargando = true;
    private string? usuarioId;

    private bool mostrandoAnular;
    private string? motivo;
    private bool anulando;
    private string? error;
    private string? aviso;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;

        var estado = await Auth.GetAuthenticationStateAsync();
        usuarioId = estado.User.Identity?.Name;

        factura = await ServicioVentas.ObtenerDetalleAsync(Id);
        cargando = false;
    }

    private void MostrarAnular()
    {
        mostrandoAnular = true;
        error = aviso = null;
    }

    private void CancelarAnular()
    {
        mostrandoAnular = false;
        motivo = null;
        error = null;
    }

    private async Task ConfirmarAnular()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(motivo))
        {
            error = "Escribe el motivo de la anulación.";
            return;
        }

        anulando = true;

        try
        {
            var resultado = await ServicioVentas.AnularAsync(Id, motivo!, usuarioId);

            if (resultado.Fallo)
            {
                error = resultado.Error;
                return;
            }

            // La factura se recarga: ahora aparece anulada, con su motivo.
            factura = await ServicioVentas.ObtenerDetalleAsync(Id);
            mostrandoAnular = false;
            motivo = null;
            aviso = "Factura anulada. El inventario se repuso" +
                (factura?.Condicion == CondicionPago.Credito ? " y se descargó la deuda del cliente." : ".");
        }
        finally
        {
            anulando = false;
        }
    }

    private async Task Imprimir() => await JS.InvokeVoidAsync("print");
}
