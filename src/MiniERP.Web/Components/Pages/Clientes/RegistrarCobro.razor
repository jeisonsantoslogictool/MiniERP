@page "/clientes/{ClienteId:int}/cobro"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IClienteService ServicioClientes
@inject ICobrosService ServicioCobros
@inject NavigationManager Navegacion

<PageTitle>Registrar Cobro</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">Registrar Cobro a Cliente</h3>
            </div>
            <div class="card-body">
                @if (cliente is null)
                {
                    <p class="text-muted">Cargando datos del cliente...</p>
                }
                else
                {
                    <div class="mb-4">
                        <h4 class="mb-1">@cliente.Nombre</h4>
                        <p class="text-muted mb-0">Código: <code>@cliente.Codigo</code></p>
                        <hr />
                        <div class="p-3 bg-light rounded d-flex justify-content-between align-items-center">
                            <span class="text-muted">Balance Pendiente (Deuda Actual):</span>
                            <span class="fs-4 fw-semibold text-danger">@Formato.Dinero(cliente.BalanceActual)</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger">@mensajeError</div>
                    }

                    <EditForm Model="form" OnValidSubmit="Guardar">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Monto a Cobrar (RD$)</label>
                            <InputNumber @bind-Value="form.Monto" class="form-control form-control-lg text-end" placeholder="0.00" />
                            <ValidationMessage For="() => form.Monto" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Observación / Concepto</label>
                            <InputText @bind-Value="form.Observacion" class="form-control" placeholder="Ej. Abono a cuenta, pago factura..." />
                            <ValidationMessage For="() => form.Observacion" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/clientes" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-success btn-lg" disabled="@(form.Monto <= 0 || form.Monto > cliente.BalanceActual)">
                                Registrar Cobro
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int ClienteId { get; set; }

    private ClienteFormDto? cliente;
    private CobroFormDto form = new();
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        cliente = await ServicioClientes.ObtenerParaEditarAsync(ClienteId);
        if (cliente is null)
        {
            Navegacion.NavigateTo("/clientes");
            return;
        }

        form.ClienteId = cliente.Id;
        form.ClienteNombre = cliente.Nombre;
        form.BalanceActual = cliente.BalanceActual;
        form.Monto = cliente.BalanceActual; // Sugerir el saldo completo por defecto
    }

    private async Task Guardar()
    {
        mensajeError = null;

        var resultado = await ServicioCobros.RegistrarCobroAsync(form, "Dionis");
        if (resultado.Exito)
        {
            Navegacion.NavigateTo("/clientes");
        }
        else
        {
            mensajeError = resultado.Error;
        }
    }
}
