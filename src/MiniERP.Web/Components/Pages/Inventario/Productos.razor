@page "/inventario/productos"
@attribute [Authorize(Policy = Permisos.InventarioVer)]
@rendermode InteractiveServer
@inject IProductoService ServicioProductos
@inject ICategoriaService ServicioCategorias

<PageTitle>Productos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Productos</h1>
    <a class="btn btn-primary" href="/inventario/productos/nuevo">Nuevo producto</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-5">
        <input class="form-control" placeholder="Buscar por código, barras o descripción"
               value="@texto" @oninput="OnTextoChanged" />
    </div>
    <div class="col-md-4">
        <select class="form-select" value="@(categoriaId?.ToString() ?? "")" @onchange="OnCategoriaChanged">
            <option value="">Todas las categorías</option>
            @foreach (var c in categorias)
            {
                <option value="@c.Id">@c.Texto</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chkReab"
                   checked="@soloReabastecer" @onchange="OnReabastecerChanged" />
            <label class="form-check-label" for="chkReab">Solo por reabastecer</label>
        </div>
    </div>
</div>

@if (pagina is null)
{
    <p class="text-muted">Cargando...</p>
}
else if (pagina.Total == 0)
{
    <div class="alert alert-secondary">No hay productos que coincidan con la búsqueda.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Categoría</th>
                    <th class="text-end">Costo</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Con ITBIS</th>
                    <th class="text-end">Margen</th>
                    <th class="text-end">Existencia</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in pagina.Items)
                {
                    <tr class="@(p.Activo ? "" : "opacity-50")">
                        <td><code>@p.Codigo</code></td>
                        <td>
                            @p.Descripcion
                            @if (!p.Activo)
                            {
                                <span class="badge text-bg-secondary ms-1">Inactivo</span>
                            }
                        </td>
                        <td class="text-muted">@p.Categoria</td>
                        <td class="text-end">@Formato.Dinero(p.Costo)</td>
                        <td class="text-end">@Formato.Dinero(p.PrecioVenta)</td>
                        <td class="text-end text-muted">@Formato.Dinero(p.PrecioConItbis)</td>
                        <td class="text-end @(p.MargenPorcentaje <= 0 ? "text-danger" : "")">
                            @Formato.Porcentaje(p.MargenPorcentaje)
                        </td>
                        <td class="text-end">
                            @if (!p.RequiereReabastecimiento)
                            {
                                <span>@Formato.Cantidad(p.Existencia, p.PermiteDecimales) @p.UnidadMedida</span>
                            }
                            else if (p.Agotado)
                            {
                                <span class="badge text-bg-danger">Agotado</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">
                                    @Formato.Cantidad(p.Existencia, p.PermiteDecimales) @p.UnidadMedida
                                </span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" href="/inventario/productos/@p.Id">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <small class="text-muted">
            @pagina.Total producto(s) · página @pagina.Pagina de @Math.Max(1, pagina.TotalPaginas)
        </small>
        <div class="btn-group">
            <button class="btn btn-sm btn-outline-secondary" disabled="@(!pagina.HayAnterior)"
                    @onclick="() => IrAPagina(pagina.Pagina - 1)">Anterior</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(!pagina.HaySiguiente)"
                    @onclick="() => IrAPagina(pagina.Pagina + 1)">Siguiente</button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "reabastecer")]
    public bool? ReabastecerQuery { get; set; }

    private PaginaDe<ProductoListaDto>? pagina;
    private IReadOnlyList<OpcionDto> categorias = [];

    private string? texto;
    private int? categoriaId;
    private bool soloReabastecer;
    private int paginaActual = 1;

    protected override async Task OnInitializedAsync()
    {
        soloReabastecer = ReabastecerQuery ?? false;
        categorias = await ServicioCategorias.ObtenerOpcionesAsync();
        await Cargar();
    }

    private async Task Cargar()
    {
        pagina = await ServicioProductos.BuscarAsync(new FiltroProductos(
            Texto: texto,
            CategoriaId: categoriaId,
            SoloReabastecer: soloReabastecer,
            SoloActivos: false,
            Pagina: paginaActual));
    }

    private async Task OnTextoChanged(ChangeEventArgs e)
    {
        texto = e.Value?.ToString();
        paginaActual = 1;
        await Cargar();
    }

    private async Task OnCategoriaChanged(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();
        categoriaId = string.IsNullOrEmpty(valor) ? null : int.Parse(valor);
        paginaActual = 1;
        await Cargar();
    }

    private async Task OnReabastecerChanged(ChangeEventArgs e)
    {
        soloReabastecer = (bool?)e.Value ?? false;
        paginaActual = 1;
        await Cargar();
    }

    private async Task IrAPagina(int numero)
    {
        paginaActual = numero;
        await Cargar();
    }
}
